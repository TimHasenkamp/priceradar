{
	"name": "priceradar-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"mock": "node scripts/mock-api.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^7.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"chart.js": "^4.6.1",
		"chartjs-adapter-date-fns": "^3.0.0",
		"date-fns": "^4.4.0"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
