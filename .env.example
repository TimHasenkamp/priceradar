# Copy to .env and adjust. All values shown are the defaults.

# --- Scraper ---
# How often all (non-paused) products are checked.
PR_SCRAPE_INTERVAL=6h
# Pause between two requests to the same shop, plus random jitter in [0, jitter).
PR_REQUEST_DELAY=15s
PR_REQUEST_JITTER=10s
# Retries for transient/blocked errors in the periodic run (backoff: 30s, 2m, 8m, ...).
PR_MAX_RETRIES=3
PR_RETRY_BACKOFF=30s
# Browser navigation timeout in the fetcher sidecar.
PR_FETCH_TIMEOUT=60s
# Shared secret with the fetcher (FETCHER_TOKEN there). Required when the
# fetcher runs on another machine (see docker-compose.fetcher.yml).
# PR_FETCHER_TOKEN=
# Identifies us when reading robots.txt.
PR_USER_AGENT=PriceRadar/0.1 (+self-hosted price tracker)

# --- Logging ---
# LOG_LEVEL: debug | info | warn | error — LOG_FORMAT: json | text
LOG_LEVEL=info
LOG_FORMAT=json

# --- Only needed outside docker compose (compose sets these itself) ---
# PR_LISTEN_ADDR=:8080
# PR_DB_PATH=priceradar.db
# PR_FETCHER_URL=http://localhost:8000

# --- docker compose ---
# Image tag to pull: latest (main branch), a release like 0.1.0, or sha-abc1234.
PRICERADAR_TAG=latest
WEB_PORT=3000
# Public URL of the web UI (needed by SvelteKit's adapter-node).
ORIGIN=http://localhost:3000
# Hosts the fetcher sidecar is allowed to open (comma-separated).
FETCHER_ALLOWED_HOSTS=www.otto.de,otto.de
